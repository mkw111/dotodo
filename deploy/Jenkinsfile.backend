pipeline {
    agent { label 'dotodo-docker' }
    options { disableConcurrentBuilds() }
    triggers { pollSCM('H/5 * * * *') }
    parameters {
        string(name: 'RELEASE_SHA', defaultValue: '', description: 'Exact Git commit to build. Blank uses the configured branch.')
    }
    stages {
        stage('Build and test') {
            steps {
                sh 'sh deploy/build-image.sh backend'
            }
        }
        stage('Deploy backend') {
            steps {
                sh 'sh deploy/deploy-local.sh backend'
            }
        }
    }
}

pipeline {
    agent { label 'dotodo-docker' }
    options { disableConcurrentBuilds() }
    parameters {
        string(name: 'RELEASE_SHA', defaultValue: '', description: 'Exact Git commit to build. Blank uses the configured branch.')
    }
    stages {
        stage('Build, test and publish') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dotodo-dockerhub',
                    usernameVariable: 'DOCKERHUB_USER', passwordVariable: 'DOCKERHUB_TOKEN')]) {
                    sh 'sh deploy/publish-image.sh frontend'
                }
            }
        }
    }
}
